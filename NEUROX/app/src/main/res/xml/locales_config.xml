<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the languages the app actually ships, so the Android 13+ per-app
     language picker offers exactly those and not the device's full list. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fa" />
</locale-config>
