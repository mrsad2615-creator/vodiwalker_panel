<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12–15 (API 31+) Data Extraction Rules: exclude personalized ML weights & logs from cloud backup -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="vodigesture_vault.db" />
        <exclude domain="database" path="vodigesture_vault.db-wal" />
        <exclude domain="database" path="vodigesture_vault.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="database" path="vodigesture_vault.db-wal" />
    </device-transfer>
</data-extraction-rules>
