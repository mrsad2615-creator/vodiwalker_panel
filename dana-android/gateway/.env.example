# Operator settings only. Do not include service credentials in Android or in Git.
MRSAD_AUTH_ORIGIN=
MRSAD_AUTH_PUBLISHABLE_KEY=
MRSAD_PUBLIC_SIGNUP=false
MRSAD_MEMBER_IDS=
MRSAD_DB_PATH=/data/usage.sqlite3
MRSAD_ACCOUNT_DAILY_UNITS=12
MRSAD_TOTAL_DAILY_UNITS=100
# Exact JSON list of objects with id (OpenRouter slug), title, and provider; enable only tested models.
MRSAD_TEXT_MODELS=[]
MRSAD_PLANNER_MODEL=
MRSAD_OPENROUTER_KEY=
# Supported image route IDs: openai-sunburst,avalai-sunburst,gemini-pro. Keys for enabled routes only.
MRSAD_IMAGE_MODELS=
MRSAD_OPENAI_KEY=
MRSAD_AVALAI_KEY=
MRSAD_GOOGLE_KEY=
