<!--
  H APERTURE SIGNATURE — the launcher foreground.

  ## What the mark is

  A six-blade iris with an open housing. The blades are chords that rotate inward and
  leave a hexagonal pupil. The pupil is the only filled shape, so it is what survives at
  the smallest size; at 24 dp the blades merge into a ring and the pupil still reads.

  ## Why an aperture

  A camera roll is a set of photographs, and a photograph is light through an opening.
  The aperture is the one shape in photography that is also a letter: the two housing
  arcs leave gaps at opposite corners, and with the pupil between them the mark reads as
  an H without drawing an H. Nothing is imitated: no circle, no burst, no flower.

  ## Construction

  A 108 x 108 viewport. The artwork is centred on (54, 54) and stays inside the 72 x 72
  safe circle, which is 18 dp of bleed on every side at mdpi.

  - Housing: two arcs of 164 degrees at radius 26, opening at 8-172 and 188-352.
    The two gaps sit at the right and the left, so the silhouette is not a ring.
  - Blades: six chords. Each runs from the inner hexagon at radius 12 to the housing at
    radius 25, offset 60 degrees from the next, which is what leaves the pupil.
  - Pupil: a hexagon at radius 5.5, filled.

  Every radius is a whole or half number on a 4-unit grid, and the stroke is 4 units at
  108, so the mark stays crisp after a launcher mask and at 24 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      The housing: two 164 degree arcs at radius 26, open at the left and the right.
      The openings are what stop the mark from reading as a plain ring.
    -->
    <path
        android:pathData="M51.3,28.1 A26,26 0 0,1 63.7,78.1"
        android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M56.7,79.9 A26,26 0 0,1 44.3,29.9"
        android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!--
      Six blades. Each one is an edge of the pupil hexagon pushed outward to the
      housing, so the six edges together form the tangent polygon that a real iris
      makes. Drawn from the centre outward they would converge instead, which is a
      star, not an aperture.
    -->
    <path android:pathData="M57.2,48.5 L66,33.2" android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="3.4" android:strokeLineCap="round" />
    <path android:pathData="M60.4,54 L78,54" android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="3.4" android:strokeLineCap="round" />
    <path android:pathData="M57.2,59.5 L66,74.8" android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="3.4" android:strokeLineCap="round" />
    <path android:pathData="M50.8,59.5 L42,74.8" android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="3.4" android:strokeLineCap="round" />
    <path android:pathData="M47.6,54 L30,54" android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="3.4" android:strokeLineCap="round" />
    <path android:pathData="M50.8,48.5 L42,33.2" android:strokeColor="@color/ic_mark_stroke"
        android:strokeWidth="3.4" android:strokeLineCap="round" />

    <!--
      The pupil: the only filled shape in the mark, so it is what survives at 24 dp.
      A hexagon at radius 6.2, aligned with the blade edges.
    -->
    <path
        android:pathData="M54,47.8 L59.4,50.9 L59.4,57.1 L54,60.2 L48.6,57.1 L48.6,50.9 Z"
        android:fillColor="@color/ic_mark_pupil" />
</vector>
