<?xml version="1.0" encoding="utf-8"?>
<!--
  HYBRID GALLERY — monochrome launcher icon, for Android 13 themed icons.

  The system recolours this to the user's wallpaper palette, so it must carry shape
  only: no gradients, no alpha, one fill colour. The geometry is identical to the
  full-colour foreground, because a themed icon that changes shape when the theme
  changes looks like two different products.

  The spine is punched out of the frames rather than drawn white, because a white
  element would be recoloured to the same tone as the frames and the H would vanish.
  That is why the two frames are separate paths with a gap rather than one path.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      H Aperture Signature, one colour.

      Android tints this layer with the user's wallpaper palette, so the mark has to
      read without the contrast between an accent ring and a pale pupil. The housing and
      the six blades are drawn at full stroke weight and the pupil is left hollow: in a
      single colour a filled pupil would merge into the blades and the opening would
      disappear.
    -->
    <path
        android:pathData="M51.3,28.1 A26,26 0 0,1 63.7,78.1"
        android:strokeColor="#000000" android:strokeWidth="4.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M56.7,79.9 A26,26 0 0,1 44.3,29.9"
        android:strokeColor="#000000" android:strokeWidth="4.4"
        android:strokeLineCap="round" />
    <path android:pathData="M57.2,48.5 L66,33.2" android:strokeColor="#000000"
        android:strokeWidth="3.8" android:strokeLineCap="round" />
    <path android:pathData="M60.4,54 L78,54" android:strokeColor="#000000"
        android:strokeWidth="3.8" android:strokeLineCap="round" />
    <path android:pathData="M57.2,59.5 L66,74.8" android:strokeColor="#000000"
        android:strokeWidth="3.8" android:strokeLineCap="round" />
    <path android:pathData="M50.8,59.5 L42,74.8" android:strokeColor="#000000"
        android:strokeWidth="3.8" android:strokeLineCap="round" />
    <path android:pathData="M47.6,54 L30,54" android:strokeColor="#000000"
        android:strokeWidth="3.8" android:strokeLineCap="round" />
    <path android:pathData="M50.8,48.5 L42,33.2" android:strokeColor="#000000"
        android:strokeWidth="3.8" android:strokeLineCap="round" />
</vector>
