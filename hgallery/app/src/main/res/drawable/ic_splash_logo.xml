<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark for the system splash screen.

  Android draws this inside a 192 dp circle on a 288 dp canvas, so the artwork is
  scaled to 0.6 and centred: reusing the launcher foreground here would draw it at full
  bleed and the platform would crop the housing.

  The colours are the accent ring on NOIR black, the same pair as the launcher plate, so
  the system splash and the application's own first frame are the same object. The
  window background is fixed per night mode in values/colors.xml and
  values-night/colors.xml; this drawable cannot read the Compose theme, which is why the
  ring carries its own contrast rather than depending on the window.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.6"
        android:scaleY="0.6">

        <!-- The housing: two 164 degree arcs, open left and right. -->
        <path
            android:pathData="M51.3,28.1 A26,26 0 0,1 63.7,78.1"
            android:strokeColor="#F28A36" android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M56.7,79.9 A26,26 0 0,1 44.3,29.9"
            android:strokeColor="#F28A36" android:strokeWidth="4"
            android:strokeLineCap="round" />

        <!-- Six blades, each an edge of the pupil hexagon pushed out to the housing. -->
        <path android:pathData="M57.2,48.5 L66,33.2" android:strokeColor="#F28A36"
            android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M60.4,54 L78,54" android:strokeColor="#F28A36"
            android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M57.2,59.5 L66,74.8" android:strokeColor="#F28A36"
            android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M50.8,59.5 L42,74.8" android:strokeColor="#F28A36"
            android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M47.6,54 L30,54" android:strokeColor="#F28A36"
            android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M50.8,48.5 L42,33.2" android:strokeColor="#F28A36"
            android:strokeWidth="3.4" android:strokeLineCap="round" />

        <!-- The pupil. -->
        <path
            android:pathData="M54,47.8 L59.4,50.9 L59.4,57.1 L54,60.2 L48.6,57.1 L48.6,50.9 Z"
            android:fillColor="#F2F0EB" />
</group>
</vector>
