<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch window is drawn by the system before any Compose code runs, so it cannot
      read the user's stored theme. The platform night mode is the only signal available at
      that moment, and following it keeps the hand-off from flashing: without this file a
      dark-mode launch shows a white rectangle for one frame.

      The value matches the app's own dark background, not the light one.
    -->
    <color name="splash_background">#050505</color>
</resources>
