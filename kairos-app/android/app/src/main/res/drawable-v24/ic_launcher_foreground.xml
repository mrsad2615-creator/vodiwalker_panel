<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle obsidian ambient radial halo inside safe zone -->
    <path android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#33204F" android:offset="0.0" />
                <item android:color="#15141B" android:offset="0.6" />
                <item android:color="#09090D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crisp Luxury Purple Orbital Arc -->
    <path
        android:pathData="M78,38 A28,28 0 1,0 78,70"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#B69AEF" android:offset="0.0" />
                <item android:color="#8052D6" android:offset="0.65" />
                <item android:color="#5B34A8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sculptural Architectural "M" Monogram (mrsad) -->
    <path
        android:pathData="M39,69 V43 L54,59 L69,43 V69"
        android:strokeColor="#F4F1F8"
        android:strokeWidth="4.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Crown Lavender Node -->
    <path
        android:pathData="M54,37m-2.6,0a2.6,2.6 0,1 1,5.2 0a2.6,2.6 0,1 1,-5.2 0"
        android:fillColor="#B69AEF" />
</vector>
