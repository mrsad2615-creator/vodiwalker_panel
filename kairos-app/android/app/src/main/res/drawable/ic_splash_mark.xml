<?xml version="1.0" encoding="utf-8"?>
<!--
    KAIROS splash mark — the approved logo as a vector, not a bitmap.

    It is the exact geometry of the in-app mark (389 × 432 units, 4 contours,
    even-odd), centred in a square 432-unit viewport so the Android 12 splash
    mask / centring never distorts it. 2 KB, crisp at every density, and it
    replaces five PNG density buckets (~54 KB in the APK).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">

    <group android:translateX="21.5">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M0,0 21,0 21,194 1,214Z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M256,0 389,2 21,371 21,432 0,432 1,255Z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M264,19 21,263 21,343 343,20Z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M196,239 388,432 249,432 219,402 125,307 139,292 260,413 341,413 185,256 183,251Z" />
    </group>
</vector>
