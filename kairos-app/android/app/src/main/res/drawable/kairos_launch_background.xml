<?xml version="1.0" encoding="utf-8"?>
<!--
    Windowing background for Android 7–11 (API 24–30).

    Those versions do not have the SplashScreen API, so this layer-list *is* the
    launch screen: pure black with the mark centred. Android 12+ uses
    windowSplashScreen* from the theme instead. Either way the user sees the
    same frame — black + the white mark — before the in-app cinematic motion
    takes over.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kairosSplashBackground" />
    <item
        android:drawable="@drawable/ic_splash_mark"
        android:gravity="center" />
</layer-list>
