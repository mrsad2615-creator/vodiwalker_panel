<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/annual_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical" android:background="@drawable/section_widget_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="رد پای سال" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAIROS"
            android:letterSpacing="0.08" android:textColor="#FFC2C2CC" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/annual_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="برای دیدن گزارش برنامه را باز کن" android:textColor="#FFE0D3FF" android:textSize="13sp" />
    <TextView android:id="@+id/annual_graph" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:text="" android:textColor="#FFFFFFFF" android:textSize="21sp" android:maxLines="1" />
    <TextView android:id="@+id/annual_axis" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="فروردین تا اسفند · بر پایهٔ تاریخ تکمیل" android:textColor="#FFD5D5DF" android:textSize="11sp" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no" />
    <TextView android:id="@+id/annual_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="برای تازه‌سازی لمس کن" android:textColor="#FFC2C2CC" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
