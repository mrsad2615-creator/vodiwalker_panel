<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/annual_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical" android:background="@drawable/section_widget_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="10dp">

    <!-- Explicit LTR container keeps the Latin brand on the left, away from the Persian title. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layoutDirection="ltr" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="KAIROS" android:letterSpacing="0.1" android:textColor="#FFBCB7CD" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:gravity="end" android:textDirection="rtl"
            android:text="رد پای سال" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="16sp" />
    </LinearLayout>
    <TextView android:id="@+id/annual_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="start" android:textDirection="rtl" android:maxLines="2"
        android:text="برای دیدن گزارش برنامه را باز کن" android:textColor="#FFE0D3FF" android:textSize="13sp" />
    <ImageView android:id="@+id/annual_graph" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginTop="7dp" android:scaleType="fitXY" android:contentDescription="نمودار تکمیل ماهانه" />
    <LinearLayout android:id="@+id/annual_labels" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layoutDirection="rtl" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="فروردین" android:gravity="start" android:textColor="#FFBEB9CE" android:textSize="10sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اسفند" android:textColor="#FFBEB9CE" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/annual_axis" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:gravity="start" android:textDirection="rtl"
        android:text="بر پایهٔ تاریخ تکمیل وظایف" android:textColor="#FFC9C5D5" android:textSize="10sp" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no" />
    <TextView android:id="@+id/annual_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="start" android:textDirection="rtl" android:text="برای تازه‌سازی لمس کن"
        android:textColor="#FFBEB9CE" android:textSize="10sp" android:maxLines="1" />
</LinearLayout>
