<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical" android:background="@drawable/section_widget_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KAIROS"
            android:letterSpacing="0.1" android:textColor="#FFBCB7CD" android:textSize="10sp" />
        <TextView android:id="@+id/daily_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:gravity="end" android:textDirection="rtl"
            android:text="کارهای امروز" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="16sp" />
    </LinearLayout>
    <TextView android:id="@+id/daily_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="برای دیدن وظایف برنامه را باز کن" android:textColor="#FFE0D3FF" android:textSize="13sp" />
    <ProgressBar android:id="@+id/daily_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
        android:max="100" android:progress="0" android:progressTint="#FFB7A3FF" android:progressBackgroundTint="#55FFFFFF" />
    <TextView android:id="@+id/daily_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:text="برای تازه‌سازی برنامه را باز کن" android:textColor="#FFD5D5DF" android:textSize="12sp" android:maxLines="2" />
    <TextView android:id="@+id/daily_row_1" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical|start" android:paddingStart="8dp" android:paddingEnd="8dp" android:ellipsize="end" android:maxLines="1"
        android:textColor="#FFFFFFFF" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/daily_row_2" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical|start" android:paddingStart="8dp" android:paddingEnd="8dp" android:ellipsize="end" android:maxLines="1"
        android:textColor="#FFFFFFFF" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/daily_row_3" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical|start" android:paddingStart="8dp" android:paddingEnd="8dp" android:ellipsize="end" android:maxLines="1"
        android:textColor="#FFFFFFFF" android:textSize="13sp" android:visibility="gone" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no" />
    <TextView android:id="@+id/daily_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="برای تازه‌سازی لمس کن" android:textColor="#FFC2C2CC" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
