<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/chrono_widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/section_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="KAIROS" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" />
    <TextView android:id="@+id/section_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="برای شروع برنامه را باز کن" android:textColor="#FFE0D3FF" android:textSize="12sp" />
    <TextView android:id="@+id/section_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="3" android:ellipsize="end" android:text="اطلاعات نمایش داده می‌شود"
        android:textColor="#D9FFFFFF" android:textSize="11sp" />
</LinearLayout>
