<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- KAIROS Luxury Obsidian Base Theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/kairosBackground</item>
        <item name="android:statusBarColor">@color/kairosBackground</item>
        <item name="android:navigationBarColor">@color/kairosBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/kairosBackground</item>
        <item name="android:statusBarColor">@color/kairosBackground</item>
        <item name="android:navigationBarColor">@color/kairosBackground</item>
    </style>

    <!--
        Launch theme.
          API 31+  system SplashScreen API: pure black window + the white mark,
                   no icon background circle, so nothing is masked or cropped.
          API 24-30 the window background (kairos_launch_background) is the
                   splash: black + centred mark.
        Either way the hand-off is black → in-app cinematic logo motion.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kairosSplashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/kairos_launch_background</item>
        <item name="android:statusBarColor">@color/kairosSplashBackground</item>
        <item name="android:navigationBarColor">@color/kairosSplashBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
