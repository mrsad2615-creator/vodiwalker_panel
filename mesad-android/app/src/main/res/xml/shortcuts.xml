<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="new_alarm" android:enabled="true" android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="New alarm" android:shortcutLongLabel="Create a new MESAD alarm">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.mesad.time" android:targetClass="com.mesad.time.MainActivity" android:data="mesad://alarm/new" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut android:shortcutId="stopwatch" android:enabled="true" android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="Stopwatch" android:shortcutLongLabel="Open MESAD Stopwatch">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.mesad.time" android:targetClass="com.mesad.time.MainActivity" android:data="mesad://stopwatch" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut android:shortcutId="timer" android:enabled="true" android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="New timer" android:shortcutLongLabel="Start a MESAD timer">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.mesad.time" android:targetClass="com.mesad.time.MainActivity" android:data="mesad://timer" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
