<?xml version="1.0" encoding="utf-8"?>
<!-- Fusion-M mark: extruded silver M with one orbital ring (vector original). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- orbital ring (behind the M) -->
    <path
        android:pathData="M14,58 C24,50 84,50 94,58"
        android:strokeColor="#5DC8E8"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round" />

    <!-- M body: left stem, left diagonal, right diagonal, right stem -->
    <path
        android:pathData="M30,78 L30,30 L38,30 L54,56 L70,30 L78,30 L78,78 L70,78 L70,44 L54,70 L38,44 L38,78 Z"
        android:fillColor="#D8DDE5" />

    <!-- brushed highlight on the upper facets -->
    <path
        android:pathData="M30,30 L38,30 L54,56 L54,62 L38,40 Z"
        android:fillColor="#F5F6F8"
        android:fillAlpha="0.75" />
    <path
        android:pathData="M78,30 L78,44 L70,44 L70,36 Z"
        android:fillColor="#F5F6F8"
        android:fillAlpha="0.55" />

    <!-- deep shading on the lower facets for material depth -->
    <path
        android:pathData="M38,44 L54,70 L70,44 L70,52 L54,78 L38,52 Z"
        android:fillColor="#17191F"
        android:fillAlpha="0.85" />

    <!-- orbital ring (in front) -->
    <path
        android:pathData="M18,64 C30,72 78,72 90,64"
        android:strokeColor="#AEB4BE"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round" />
</vector>
