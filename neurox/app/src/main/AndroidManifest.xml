<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Core features are offline. No INTERNET permission. -->
    <application android:name=".NeuroxApplication" android:label="NEUROX"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Neurox" android:supportsRtl="true"
        android:allowBackup="false" android:fullBackupContent="false"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
